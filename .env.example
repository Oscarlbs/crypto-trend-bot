# Copia este archivo a .env y rellénalo. .env está en .gitignore: no lo subas a ningún sitio.

BOT_MODE=paper        # paper = simulado con precios reales | live = dinero real
BOT_BUDGET=100        # EUR reales que gestiona el bot en live. El kill switch salta al 75 % de esto.
                      # En paper no se usa: la prueba va con 10.000 EUR de mentira (bot/config.py).

# Solo para live. Clave con permiso de trading spot ÚNICAMENTE, retiradas desactivadas.
API_KEY=
API_SECRET=

# Opcional: alertas por Telegram (pasos en el README). El token lo da @BotFather; el chat id sale con
#   docker compose run --rm trendbot python -m bot.notify --chat-id
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Usuario con el que corre el contenedor: el tuyo del servidor (salida de `id -u` y `id -g`).
# APP_UID=1001
# APP_GID=1001
